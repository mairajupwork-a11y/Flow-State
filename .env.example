# Copy this file to .env (same folder) and fill in the values you need.
# WorkMars reads it automatically on start. Never commit your real .env.

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (no setup needed).
# For Supabase: Project → Connect → "Session pooler" connection string,
# with your database password in place of [YOUR-PASSWORD]. See SUPABASE.md.
DATABASE_URL=
# Optional: path to Supabase's CA certificate (Project Settings → Database →
# SSL configuration → Download certificate) to fully verify the TLS connection.
DATABASE_CA_CERT=

# --- Sign in with Google (optional) -------------------------------------
# Create an OAuth "Web application" client in Google Cloud — see GOOGLE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Invitation emails (optional) ---------------------------------------
# Any SMTP account — e.g. Gmail with an App Password. See EMAIL.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The address people open WorkMars on, used for links in emails and the
# calendar feed. Leave empty while testing locally; set it once WorkMars is
# online (required for password-reset emails on a live server).
APP_URL=

# --- Push notifications (optional) ---------------------------------------
# Nothing to do: WorkMars creates its push keys on first start and keeps them
# in the database. Only set these to use keys you generated yourself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Only when hosting behind a reverse proxy (Render, Railway, nginx): how many proxy
# hops to trust for the visitor's real IP and HTTPS. Defaults to 1 in production
# and off in development. Leave empty on your own computer.
TRUST_PROXY=

# --- Server ---------------------------------------------------------------
# Required in production: any long random string (keeps people signed in).
SESSION_SECRET=
PORT=4000
